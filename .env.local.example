# Supabase — supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Meta Cloud API — developers.facebook.com → your app → WhatsApp → Getting Started
META_PHONE_NUMBER_ID=your-phone-number-id
META_ACCESS_TOKEN=your-permanent-access-token
META_WEBHOOK_VERIFY_TOKEN=sorted-webhook-verify-2026

# Stitch — dashboard.stitch.money → Developers → Credentials
# Money OUT only: paying the bills the user owes.
STITCH_CLIENT_ID=your-stitch-client-id
STITCH_CLIENT_SECRET=your-stitch-client-secret

# Paystack — dashboard.paystack.com → Settings → API Keys & Webhooks
# Money IN only: the user's own customers paying their quotes.
# Also set the webhook URL there to https://<your-domain>/api/paystack/webhook
PAYSTACK_SECRET_KEY=sk_live_...

# App — NEXT_PUBLIC_APP_URL must be the live domain, or every quote link
# Sorted WhatsApps out will point somewhere broken.
NEXT_PUBLIC_APP_URL=https://getitsorted.co.za
NEXT_PUBLIC_WHATSAPP_NUMBER=+27XXXXXXXXXX

# Cron — any long random string, protects /api/reminders from public access
CRON_SECRET=sorted-cron-2026-xk9m

# Admin dashboard (/admin) — defaults to warren@kaplan.co.za / password if unset
ADMIN_EMAIL=warren@kaplan.co.za
ADMIN_PASSWORD=password
